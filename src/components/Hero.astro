---
// src/components/Hero.astro

const { image, title, subtitle, height = '100vh', fontClass = '', align = 'center' } = Astro.props;
---

<div 
  class="hero" 
  style={`background-image: url(${image}); min-height: ${height};`}
  data-align={align}
>
  <div class="hero-overlay">
    <h1 class={fontClass}>{title}</h1>
    {subtitle && <p>{subtitle}</p>}
  </div>
</div>

<style>
  .hero {
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 100%;
  }

  /* Allineamento verticale personalizzato */
  .hero[data-align="top"] {
    align-items: flex-start;
    padding-top: 3rem;
  }

  .hero[data-align="bottom"] {
    align-items: flex-end;
    padding-bottom: 4rem;
  }

  .hero[data-align="center"] {
    align-items: center;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    z-index: 1;
  }

  .hero-overlay {
    position: relative;
    z-index: 2;
    padding: 2rem 3rem;
    text-align: center;
    color: white;
    border-radius: 8px;
    max-width: 90%;
  }

  /* Font di default (Mulish) */
  .hero-overlay h1 {
    font-family: "Yuyu Short", sans-serif;
    font-weight: 300;
    font-style: normal;
    letter-spacing: 0.15em;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
    font-size: clamp(3rem, 5vw, 4rem);
    margin-top: 0;
    margin-bottom: 0.5rem;
  }

  .hero-overlay p {
    font-family: "Yuyu Short", sans-serif;
    font-size: clamp(2.5rem, 2vw, 1.5rem);
    font-weight: 300;
    font-style: normal;
    opacity: 0.95;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
    max-width: 700px;
    margin: 0 auto;
    letter-spacing: 0.10em;
  }

  @media (max-width: 768px) {
    .hero-overlay {
      padding: 1.5rem;
    }

    /* Su mobile, se è allineato in alto, riduci il padding-top */
    .hero[data-align="top"] {
      padding-top: 2.5rem;
    }
  }
</style>