---
// src/components/NewsPreview.astro
// @ts-nocheck

// Legge tutti i file .md dalla cartella news
const newsModules = import.meta.glob('../content/news/*.md', { eager: true });

const allNews = Object.entries(newsModules).map(([filePath, module]) => {
  const fileName = filePath.split('/').pop();
  const slug = fileName ? fileName.replace(/\.md$/, '') : '';
  return {
    ...module,
    slug,
    url: `/news/${slug}`,
  };
});

// Ordina per data (dalla più recente)
const sortedNews = [...allNews].sort((a, b) => {
  return new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime();
});

// Prende solo le ultime 3
const latestNews = sortedNews.slice(0, 3);

// Formatta la data in "28 luglio 2025"
function formatDate(date) {
  const d = new Date(date);
  const day = d.getDate();
  const month = d.toLocaleString('it-IT', { month: 'long' });
  const year = d.getFullYear();
  return `${day} ${month} ${year}`;
}
---

<section class="news-preview">
  <div class="container">
    <div class="section-header">
      <h2>Ultime News</h2>
      <a href="/news" class="view-all">Tutte le news →</a>
    </div>

    {latestNews.length > 0 ? (
      <div class="news-grid">
        {latestNews.map((news: NewsItem) => (
          <a href={news.url} class="news-card-link-wrapper">
            <article class="news-card">
              <div class="news-card-image-wrapper">
                {news.frontmatter.image ? (
                  <img 
                    src={news.frontmatter.image} 
                    alt={news.frontmatter.title} 
                    class="news-card-image"
                    loading="lazy"
                  />
                ) : (
                  <div class="news-card-image-placeholder">
                    <span>🎭</span>
                  </div>
                )}
              </div>
              <div class="news-card-content">
                <time class="news-card-date">
                  {formatDate(news.frontmatter.date)}
                </time>
                <h3>{news.frontmatter.title}</h3>
                <p>{news.frontmatter.excerpt}</p>
                <span class="news-card-link">Leggi tutto →</span>
              </div>
            </article>
          </a>
        ))}
      </div>
    ) : (
      <p class="no-news">Nessuna news disponibile al momento.</p>
    )}
  </div>
</section>

<style>
  .news-preview {
    padding: 4rem 0;
    background: transparent;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2.5rem;
  }

  .section-header h2 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-color);
    margin: 0;
  }

  .view-all {
    color: var(--accent-color);
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    transition: color 0.3s ease;
  }

  .view-all:hover {
    color: var(--text-color);
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  /* ===== RENDE L'INTERA CARD CLICCABILE ===== */
  .news-card-link-wrapper {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .news-card-link-wrapper:hover {
    transform: translateY(-6px);
  }

  .news-card-link-wrapper:hover .news-card {
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.20);
  }

  .news-card {
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    overflow: hidden;
    transition: box-shadow 0.3s ease;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.10);
    height: 100%;
  }

  /* ===== IMMAGINE ===== */
  .news-card-image-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 85%; 
    overflow: hidden;
    background: var(--secondary-color);
  }

  .news-card-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.5s ease;
  }

  .news-card-link-wrapper:hover .news-card-image {
    transform: scale(1.05);
  }

  .news-card-image-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--secondary-color);
    font-size: 3rem;
    opacity: 0.4;
  }

  .news-card-content {
    padding: 1.5rem;
  }

  .news-card-date {
    font-size: 0.8rem;
    color: var(--text-color);
    opacity: 0.5;
    display: block;
    margin-bottom: 0.5rem;
  }

  .news-card-content h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-color);
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }

  .news-card-content p {
    font-size: 0.9rem;
    color: var(--text-color);
    opacity: 0.7;
    margin: 0 0 1rem 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .news-card-link {
    color: var(--accent-color);
    font-weight: 600;
    font-size: 0.9rem;
    transition: color 0.3s ease;
  }

  .news-card-link-wrapper:hover .news-card-link {
    color: var(--text-color);
  }

  .no-news {
    text-align: center;
    color: var(--text-color);
    opacity: 0.5;
    padding: 3rem 0;
  }

  /* ==========================================================
     MOBILE
     ========================================================== */
  @media (max-width: 991.98px) {
    .news-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 576px) {
    .news-grid {
      grid-template-columns: 1fr;
    }

    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>