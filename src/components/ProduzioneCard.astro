---
// src/components/ProduzioneCard.astro

export interface Props {
  produzione: {
    slug: string;
    frontmatter: {
      title: string;
      date: number;
      excerpt: string;
      cover?: string;
      regia?: string;
      durata?: string;
      isSpecial?: boolean;
      gallery?: string[];
      gallery_count?: number;
    };
  };
  r2Base: string;
  section: string;
  produzioniList: any[];
}

const { produzione, r2Base, section, produzioniList } = Astro.props;
const { frontmatter, slug } = produzione;
const coverImage = frontmatter.cover || `${r2Base}/${slug}/copertina.jpg`;
const isSpecial = frontmatter.isSpecial || false;

// Prende le prime 4 immagini della gallery
// const galleryImages = frontmatter.gallery || [];
// const galleryPreview = galleryImages.slice(0, 4);
// const hasGalleryPreview = galleryPreview.length > 0;
// Gallery preview disabled — use section page gallery instead
const hasGalleryPreview = false;

const singleUrl = `/produzioni/${section}/${slug}`;
---

<a href={singleUrl} class="produzione-card-link">
  <article class={`produzione-card ${isSpecial ? 'special' : ''}`}>
    <div class="produzione-card-content">
      {isSpecial && <span class="badge-special">⭐ Speciale</span>}
      <h2 class="produzione-card-title">{frontmatter.title}</h2>
      <div class="produzione-card-meta">
        <span class="meta-anno">{frontmatter.date}</span>
        {frontmatter.regia && <span class="meta-regia">Regia: {frontmatter.regia}</span>}
        {frontmatter.durata && <span class="meta-durata">Durata: {frontmatter.durata}</span>}
      </div>
      <p class="produzione-card-excerpt">{frontmatter.excerpt}</p>
      <span class="produzione-card-link-text">Leggi tutto →</span>
    </div>
    <div class="produzione-card-image">
      <img 
        src={coverImage} 
        alt={frontmatter.title} 
        loading="lazy"
        onerror="console.error('Copertina non trovata:', this.src)"
      />
    </div>
    
    <!-- Anteprima gallery rimossa in ProduzioneCard (commentata) -->
  </article>
</a>

<style>
  /* ==========================================================
     PRODUZIONE CARD - TESTO A SINISTRA, FOTO A DESTRA
     ========================================================== */
  .produzione-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    margin-bottom: 2.5rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .produzione-card-link:last-child {
    margin-bottom: 0;
  }

  .produzione-card-link:hover {
    transform: translateX(4px);
  }

  .produzione-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
    min-height: 260px;
  }

  .produzione-card:hover {
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
    border-color: rgba(191, 49, 49, 0.2);
  }

  /* ===== CONTENUTO TESTO ===== */
  .produzione-card-content {
    padding: 2rem 0 2rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
  }

  .badge-special {
    display: inline-block;
    background: var(--accent-color);
    color: white;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.8rem;
    border-radius: 20px;
    align-self: flex-start;
    margin-bottom: 0.25rem;
  }

  .produzione-card-title {
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 700;
    color: var(--text-color);
    margin: 0;
    line-height: 1.2;
  }

  .produzione-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.85rem;
    color: var(--text-color);
    opacity: 0.6;
  }

  .produzione-card-excerpt {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.8;
    margin: 0.25rem 0 0.5rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .produzione-card-link-text {
    color: var(--accent-color);
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.3s ease, transform 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.25rem;
  }

  .produzione-card-link:hover .produzione-card-link-text {
    color: var(--text-color);
  }

  .produzione-card-link-text::after {
    content: '→';
    transition: transform 0.3s ease;
  }

  .produzione-card-link:hover .produzione-card-link-text::after {
    transform: translateX(4px);
  }

  /* ===== COPERTINA ===== */
  .produzione-card-image {
    width: 100%;
    height: 100%;
    max-height: 320px;
    min-height: 180px;
    background: var(--secondary-color);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .produzione-card-image img {
    width: 100%;
    height: 100%;
    max-height: 320px;
    object-fit: contain;
    display: block;
    transition: transform 0.5s ease;
  }

  .produzione-card-link:hover .produzione-card-image img {
    transform: scale(1.02);
  }

  /* Gallery preview styles commented out (disabled in ProduzioneCard)
  .produzione-card-gallery-preview {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: rgba(0, 0, 0, 0.04);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    flex-wrap: wrap;
    min-height: 90px;
    width: 100%;
    box-sizing: border-box;
    grid-column: 1 / -1;
  }

  .gallery-preview-thumb {
    width: 80px;
    height: 80px;
    min-width: 80px;
    min-height: 80px;
    max-width: 80px;
    max-height: 80px;
    border-radius: 6px;
    overflow: hidden;
    background: var(--secondary-color);
    border: 1px solid rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
  }

  .gallery-preview-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gallery-preview-more {
    font-size: 0.9rem;
    color: var(--text-color);
    opacity: 0.5;
    font-weight: 600;
    padding-left: 0.3rem;
  }
  */

  /* ===== CARD SPECIALE (CovidRadioBunker) ===== */
  .produzione-card.special {
    border-left: 4px solid var(--accent-color);
    background: rgba(191, 49, 49, 0.04);
  }

  .produzione-card.special .badge-special {
    background: var(--accent-color);
  }

  .produzione-card.special .produzione-card-gallery-preview {
    background: rgba(191, 49, 49, 0.06);
  }

  /* ==========================================================
     MOBILE
     ========================================================== */
  @media (max-width: 768px) {
    .produzione-card {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .produzione-card-content {
      padding: 1.5rem;
      order: 1;
    }

    .produzione-card-image {
      max-height: 260px;
      min-height: 140px;
      order: 0;
    }

    .produzione-card-image img {
      max-height: 260px;
    }

    /* .produzione-card-gallery-preview {
      padding: 0.5rem 0.75rem;
      min-height: 70px;
      gap: 0.5rem;
    }

    .gallery-preview-thumb {
      width: 60px;
      height: 60px;
      min-width: 60px;
      min-height: 60px;
      max-width: 60px;
      max-height: 60px;
    } */

    .produzione-card-title {
      font-size: 1.4rem;
    }

    .produzione-card-excerpt {
      -webkit-line-clamp: 2;
    }

    .produzione-card-link {
      margin-bottom: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .produzione-card-image {
      max-height: 200px;
      min-height: 120px;
    }

    .produzione-card-image img {
      max-height: 200px;
    }

    .produzione-card-content {
      padding: 1.2rem;
    }

    .produzione-card-title {
      font-size: 1.2rem;
    }

    .produzione-card-excerpt {
      font-size: 0.9rem;
    }

    /* .produzione-card-gallery-preview {
      padding: 0.4rem 0.5rem;
      min-height: 60px;
      gap: 0.4rem;
    }

    .gallery-preview-thumb {
      width: 50px;
      height: 50px;
      min-width: 50px;
      min-height: 50px;
      max-width: 50px;
      max-height: 50px;
    } */
  }
</style>