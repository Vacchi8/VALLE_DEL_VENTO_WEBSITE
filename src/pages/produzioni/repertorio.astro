---
// src/pages/produzioni/repertorio.astro
// @ts-nocheck

import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import ProduzioneCard from '../../components/ProduzioneCard.astro';
import { heroConfig } from '../../config/hero-config.js';

const R2_BASE = 'https://pub-3db0a12fc0e24105bb45e72d8f025cbc.r2.dev';

// Legge tutti i file .md dalla cartella repertorio
const modules = import.meta.glob('../../content/produzioni/repertorio/*.md');

const moduleEntries = Object.entries(modules);

const allProduzioni = await Promise.all(
  moduleEntries.map(async ([filePath, module]) => {
    const fileSlug = filePath.split('/').pop().replace(/\.md$/, '');
    const mod = await module();
    const { frontmatter, default: Content } = mod;
    const slug = frontmatter.slug || fileSlug;
    return {
      slug,
      frontmatter,
      Content,
      render: mod.render,
    };
  })
);

// Ordina per data (dalla più recente)
const sortedProduzioni = allProduzioni.sort((a, b) => {
  return b.frontmatter.date - a.frontmatter.date;
});

// --- PASSA LA SEZIONE E LA LISTA COME PROPS ---
const section = 'repertorio';
const produzioniList = sortedProduzioni;
---

<Layout title="Repertorio | Valle Del Vento">
  <Hero 
    image={heroConfig.produzioni.repertorio.image}
    title={heroConfig.produzioni.repertorio.title}
    subtitle={heroConfig.produzioni.repertorio.subtitle}
  />

  <section class="produzioni-page">
    <div class="container">
      <div class="produzioni-list">
        {produzioniList.map(function(produzione) {
          return (
            <ProduzioneCard 
              produzione={produzione} 
              r2Base={R2_BASE} 
              section={section}
              produzioniList={produzioniList}
            />
          );
        })}
      </div>
    </div>
  </section>
</Layout>

<style>
  .produzioni-page {
    padding: 4rem 0;
    background: transparent;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .produzioni-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
</style>