      gap: 1rem;
    }
  }

/* ==========================================================
   MOBILE PICCOLO
========================================================== */

@media (max-width: 480px) {

  .produzione-single {
    padding: 60px 0 2rem 0;
  }


  .produzione-cover {
    max-height: 220px;
  }


  .produzione-cover img {
    max-height: 220px;
  }


  .carousel-thumbnail {
    flex: 0 0 40px;

    width: 40px;

    height: 40px;
  }


  .nav-btn-top .nav-btn-label {
    font-size: 0.65rem;
  }


  .lightbox-close {
    top: 1rem;

    right: 1rem;

    font-size: 1.5rem;
  }


  .lightbox-btn {
    width: 36px;

    height: 36px;

    font-size: 1.2rem;
  }


  .lightbox-controls {
    gap: 0.75rem;
  }


}

</style>


<script>
// @ts-nocheck

/* ==========================================================
   STATO CAROUSEL
========================================================== */

window.__vldv_carousels =
  window.__vldv_carousels || {};


/* ==========================================================
   TROVA CAROUSEL
========================================================== */

function getCarousel(galleryId) {

  const container =
    document.getElementById(galleryId);

  if (!container) {
    return null;
  }


  const track =
    container.querySelector(
      '.carousel-track'
    );

  if (!track) {
    return null;
  }


  const slides =
    track.querySelectorAll(
      '.carousel-slide'
    );


  const thumbnails =
    container.querySelectorAll(
      '.carousel-thumbnail'
    );


  const totalSlides =
    slides.length;


  if (
    !window.__vldv_carousels[
      galleryId
    ]
  ) {

    window.__vldv_carousels[
      galleryId
    ] = {

      currentIndex: 0,

      totalSlides

    };

  }


  return {

    container,

    track,

    slides,

    thumbnails,

    totalSlides

  };

}


/* ==========================================================
   AGGIORNA CAROUSEL
========================================================== */

function updateCarousel(galleryId) {

  const data =
    getCarousel(galleryId);

  if (!data) {
    return;
  }


  const {
    track,
    thumbnails,
    totalSlides
  } = data;


  const currentIndex =
    window.__vldv_carousels[
      galleryId
    ].currentIndex;


  /*
    Ogni slide è larga 100%.

    Quindi:
    0  = prima
    -100 = seconda
    -200 = terza
  */

  const offset =
    -(currentIndex * 100);


  track.style.transform =
    `translateX(${offset}%)`;


  /*
    Aggiorna miniature
  */

  thumbnails.forEach(
    (thumbnail, index) => {

      thumbnail.classList.toggle(
        'active',
        index === currentIndex
      );

    }
  );


  /*
    Aggiorna contatore
  */

  const counter =
    document.getElementById(
      `${galleryId}-counter`
    );


  if (counter) {

    counter.textContent =
      `${currentIndex + 1} / ${totalSlides}`;

  }

}


/* ==========================================================
   MUOVI CAROUSEL
========================================================== */

window.moveCarousel =
  function (
    galleryId,
    direction
  ) {

    const data =
      getCarousel(galleryId);

    if (!data) {
      return;
    }


    const {
      totalSlides
    } = data;


    let currentIndex =
      window.__vldv_carousels[
        galleryId
      ].currentIndex;


    currentIndex += direction;


    if (currentIndex < 0) {

      currentIndex =
        totalSlides - 1;

    }


    if (
      currentIndex >=
      totalSlides
    ) {

      currentIndex = 0;

    }


    window.__vldv_carousels[
      galleryId
    ].currentIndex =
      currentIndex;


    updateCarousel(galleryId);

  };


/* ==========================================================
   VAI ALLA SLIDE
========================================================== */

window.goToSlide =
  function (
    galleryId,
    index
  ) {

    const data =
      getCarousel(galleryId);

    if (!data) {
      return;
    }


    const {
      totalSlides
    } = data;


    if (
      index < 0 ||
      index >= totalSlides
    ) {

      return;

    }


    window.__vldv_carousels[
      galleryId
    ].currentIndex =
      index;


    updateCarousel(galleryId);

  };


/* ==========================================================
   LIGHTBOX
========================================================== */

let lightboxImages = [];

let lightboxIndex = 0;


/* ==========================================================
   ELEMENTI LIGHTBOX
========================================================== */

function getLightboxEls() {

  return {

    el:
      document.getElementById(
        'lightboxGallery'
      ),

    img:
      document.getElementById(
        'lightboxImage'
      ),

    counter:
      document.getElementById(
        'lightboxCounter'
      )

  };

}


/* ==========================================================
   APRI LIGHTBOX
========================================================== */

window.openLightbox =
  function (
    galleryId,
    index
  ) {

    const data =
      getCarousel(galleryId);

    if (!data) {
      return;
    }


    lightboxImages =
      Array.from(
        data.slides
      )
      .map((slide) => {

        const img =
          slide.querySelector('img');

        return img
          ? img.src
          : '';

      })
      .filter(Boolean);


    if (
      lightboxImages.length === 0
    ) {

      return;

    }


    lightboxIndex =
      Math.max(
        0,
        Math.min(
          index || 0,
          lightboxImages.length - 1
        )
      );


    updateLightbox();


    const { el } =
      getLightboxEls();


    if (el) {

      el.classList.add(
        'active'
      );

      document.body.style.overflow =
        'hidden';

    }

  };


/* ==========================================================
   CHIUDI LIGHTBOX
========================================================== */

window.closeLightbox =
  function () {

    const { el } =
      getLightboxEls();


    if (el) {

      el.classList.remove(
        'active'
      );

      document.body.style.overflow =
        '';

    }

  };


/* ==========================================================
   CAMBIA FOTO LIGHTBOX
========================================================== */

window.changeLightboxImage =
  function (direction) {

    if (
      lightboxImages.length === 0
    ) {

      return;

    }


    let newIndex =
      lightboxIndex +
      direction;


    if (newIndex < 0) {

      newIndex =
        lightboxImages.length - 1;

    }


    if (
      newIndex >=
      lightboxImages.length
    ) {

      newIndex = 0;

    }


    lightboxIndex =
      newIndex;


    updateLightbox();

  };


/* ==========================================================
   AGGIORNA LIGHTBOX
========================================================== */

function updateLightbox() {

  const {
    img,
    counter
  } = getLightboxEls();
  if (!img || !counter) {
    return;
  }
  if (
    lightboxImages.length === 0
  ) {
    return;
  }
  img.src =
    lightboxImages[
      lightboxIndex
    ];
  counter.textContent =
    `${lightboxIndex + 1} / ${lightboxImages.length}`;

}

/* ==========================================================
   INIZIALIZZA CAROUSEL
========================================================== */

function initCarousels() {

  document
    .querySelectorAll(
      '.gallery-carousel'
    )
    .forEach(
      (carousel) => {

        const galleryId =
          carousel.id;
        const slides =
          carousel.querySelectorAll(
            '.carousel-slide'
          );
        if (
          slides.length === 0
        ) {
          return;
        }


        /*
          NOTA IMPORTANTE:

          NON impostiamo più
          track.style.width.

          Il track è semplicemente
          width: 100%.
        */

        window.__vldv_carousels[
          galleryId
        ] = {
          currentIndex: 0,
          totalSlides:
            slides.length
        };
        updateCarousel(
          galleryId
        );
      }
    );

}

/* ==========================================================
   DOM READY
========================================================== */

if (
  document.readyState ===
  'loading'
) {

  document.addEventListener(
    'DOMContentLoaded',
    initCarousels
  );

} else {
  initCarousels();
}

/* ==========================================================
   TASTIERA LIGHTBOX
========================================================== */

document.addEventListener(
  'keydown',
  function (e) {

    const { el } =
      getLightboxEls();


    if (
      !el ||
      !el.classList.contains(
        'active'
      )
    ) {

      return;

    }


    if (
      e.key === 'Escape'
    ) {

      closeLightbox();

    } else if (
      e.key === 'ArrowLeft'
    ) {

      changeLightboxImage(-1);

    } else if (
      e.key === 'ArrowRight'
    ) {

      changeLightboxImage(1);

    }

  }
);


/* ==========================================================
   CLICK LIGHTBOX
========================================================== */

document.addEventListener(
  'DOMContentLoaded',
  function () {

    const {
      el,
      img
    } = getLightboxEls();
    /*
      Clic sullo sfondo:
      chiudi lightbox.
    */

    if (el) {

      el.addEventListener(
        'click',
        function (e) {

          if (
            e.target === el
          ) {

            closeLightbox();

          }

        }
      );

    }
    /*
      Clic sull'immagine:
      non chiudere.
    */

    if (img) {

      img.addEventListener(
        'click',
        function (e) {

          e.stopPropagation();

        }
      );

    }
    /*
      Clic sui controlli:
      non chiudere.
    */

    document
        .querySelectorAll(
        '.lightbox-controls'
        )
        .forEach(
        (controls) => {

            controls.addEventListener(
            'click',
            function (e) {

                e.stopPropagation();

            }
            );

        }
        );
  }
);

</script>