---
// src/pages/cookie-policy.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Cookie Policy" description="Informativa sull'uso dei cookie e gestione delle preferenze">
  <div class="container py-5">
    <div class="legal-content">
      <!-- Incolla il codice della Cookie Policy -->
      <a href="https://www.iubenda.com/privacy-policy/38896889/cookie-policy" class="iubenda-white iubenda-noiframe iubenda-embed" title="Cookie Policy ">Cookie Policy</a>
      <script type="text/javascript">
        (function (w,d) {
          var loader = function () {
            var s = d.createElement("script"), 
                tag = d.getElementsByTagName("script")[0];
            s.src="https://cdn.iubenda.com/iubenda.js";
            tag.parentNode.insertBefore(s,tag);
          };
          if(w.addEventListener){
            w.addEventListener("load", loader, false);
          } else if(w.attachEvent){
            w.attachEvent("onload", loader);
          } else {
            w.onload = loader;
          }
        })(window, document);
      </script>
    </div>
  </div>
</Layout>