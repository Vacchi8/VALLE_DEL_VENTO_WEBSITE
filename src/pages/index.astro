---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { heroConfig } from '../config/hero-config.js';
import InfoSection from '../components/InfoSection.astro';
import NewsPreview from '../components/NewsPreview.astro';
import ScuolaSection from '../components/ScuolaSection.astro';
import ProduzioniSection from '../components/ProduzioniSection.astro';
import ContattiSection from '../components/ContattiSection.astro';
import LoghiCarousel from '../components/LoghiCarousel.astro';

---

<Layout title="Home" description="Organizzazione eventi e scuola di teatro nella bassa Val Susa - Villar Dora - TO">
	<Hero 
	    image={heroConfig.home.image}
	    title={heroConfig.home.title}
	    subtitle={heroConfig.home.subtitle}
	    fontClass="font-home"
	    align="top"
	/>
	<InfoSection 
  />
	<NewsPreview />
	<ProduzioniSection />
	<ScuolaSection />
	<ContattiSection />
	<LoghiCarousel />
</Layout>
