---
// src/pages/news/[slug].astro
// @ts-nocheck

import Layout from '../../layouts/LayoutNews.astro';

// Genera le pagine statiche per ogni news
export async function getStaticPaths() {
  const newsModules = import.meta.glob('../../content/news/*.md', { eager: true });
  
  const allNews = Object.entries(newsModules).map(([filePath, module]) => {
    const fileName = filePath.split('/').pop();
    const slug = fileName ? fileName.replace(/\.md$/, '') : '';
    return {
      ...module,
      slug,
      url: `/news/${slug}`,
    };
  });
  
  const sortedNews = allNews.sort((a, b) => {
    return new Date(b.frontmatter.date) - new Date(a.frontmatter.date);
  });

  return sortedNews.map((news, index, array) => ({
    params: { slug: news.slug },
    props: { 
      news,
      prevNews: index > 0 ? array[index - 1] : null,
      nextNews: index < array.length - 1 ? array[index + 1] : null,
    },
  }));
}

const { news, prevNews, nextNews } = Astro.props;
const Content = news.default || news.Content;

function formatDate(date) {
  const d = new Date(date);
  const day = d.getDate();
  const month = d.toLocaleString('it-IT', { month: 'long' });
  const year = d.getFullYear();
  return `${day} ${month} ${year}`;
}

const hasGallery = news.frontmatter.gallery && news.frontmatter.gallery.length > 0;
const hasMeta = news.frontmatter.location || 
                news.frontmatter.eventDate || 
                news.frontmatter.eventTime || 
                news.frontmatter.contactEmail || 
                news.frontmatter.contactPhone;
---

<Layout title={`${news.frontmatter.title} | Valle Del Vento`}>
  <article class="news-single">
    <div class="container">
      <!-- ===== NAVIGAZIONE SUPERIORE ===== -->
      <nav class="news-nav-top">
        <a href="/news" class="back-link">← Torna alle news</a>
        <div class="nav-arrows-top">
          {prevNews && (
              <a href={prevNews.url} class="nav-btn-top prev" title="News precedente">
              <span class="nav-btn-icon">‹</span>
              <span class="nav-btn-label">Precedente</span>
            </a>
          )}
          {nextNews && (
            <a href={nextNews.url} class="nav-btn-top next" title="News successiva">
              <span class="nav-btn-label">Successiva</span>
              <span class="nav-btn-icon">›</span>
            </a>
          )}
        </div>
      </nav>

      <!-- ===== IMMAGINE DI COPERTINA ===== -->
      <div class="cover-image">
        <img src={news.frontmatter.image} alt={news.frontmatter.title} />
      </div>

      <!-- ===== INTESTAZIONE ===== -->
      <header class="news-header">
        <h1>{news.frontmatter.title}</h1>
        <time class="news-date">{formatDate(news.frontmatter.date)}</time>
        
        {hasMeta && (
          <div class="news-meta">
            {news.frontmatter.location && (
              <span class="meta-item">📍 {news.frontmatter.location}</span>
            )}
            {news.frontmatter.eventDate && (
              <span class="meta-item">📅 {formatDate(news.frontmatter.eventDate)}</span>
            )}
            {news.frontmatter.eventTime && (
              <span class="meta-item">🕐 {news.frontmatter.eventTime}</span>
            )}
            {news.frontmatter.contactEmail && (
              <span class="meta-item">📧 <a href={`mailto:${news.frontmatter.contactEmail}`}>{news.frontmatter.contactEmail}</a></span>
            )}
            {news.frontmatter.contactPhone && (
              <span class="meta-item">📞 <a href={`tel:${news.frontmatter.contactPhone}`}>{news.frontmatter.contactPhone}</a></span>
            )}
          </div>
        )}
      </header>

      <!-- ===== CONTENUTO MARKDOWN ===== -->
      <div class="news-content">
        <Content />
      </div>

      <!-- ===== GALLERIA ===== -->
      {hasGallery && (
        <section class="news-gallery">
          <h3>Galleria immagini</h3>
          <div class="gallery-grid" id="galleryGrid">
            {news.frontmatter.gallery.map(function(img, index) {
              return (
                <div class="gallery-item" data-index={index}>
                  <img 
                    src={img} 
                    alt={"Foto " + (index + 1) + " della news"} 
                    loading="lazy"
                    onclick="openLightbox(this)"
                  />
                </div>
              );
            })}
          </div>
        </section>
      )}

      <!-- ===== NAVIGAZIONE INFERIORE ===== -->
      <nav class="news-nav-bottom">
        {prevNews && (
            <a href={prevNews.url} class="nav-bottom-link prev">
            <span class="nav-bottom-arrow">←</span>
            <span class="nav-bottom-text">{prevNews.frontmatter.title}</span>
          </a>
        )}
        <a href="/news" class="nav-bottom-link center">Tutte le news</a>
        {nextNews && (
          <a href={nextNews.url} class="nav-bottom-link next">
            <span class="nav-bottom-text">{nextNews.frontmatter.title}</span>
            <span class="nav-bottom-arrow">→</span>
          </a>
        )}
      </nav>
    </div>
  </article>
</Layout>

<!-- ===== LIGHTBOX ===== -->
<div id="lightbox" class="lightbox" onclick="closeLightbox()">
  <button class="lightbox-close" onclick="closeLightbox()">✕</button>
  <img id="lightboxImage" src="" alt="Immagine ingrandita" />
  <div class="lightbox-controls">
    <button class="lightbox-btn prev" onclick="changeImage(-1)">‹</button>
    <span class="lightbox-counter" id="lightboxCounter">1 / 1</span>
    <button class="lightbox-btn next" onclick="changeImage(1)">›</button>
  </div>
</div>

<style>
  /* ==========================================================
     PAGINA SINGOLA NEWS
     ========================================================== */
  .news-single {
    padding: 100px 0 4rem 0; /* Aumentato da 80px a 100px per più spazio sotto la navbar */
    background: transparent;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ==========================================================
     NAVIGAZIONE SUPERIORE
     ========================================================== */
  .news-nav-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2.5rem; /* Aumentato da 2rem a 2.5rem */
    gap: 1rem;
  }

  .back-link {
    color: var(--text-color);
    opacity: 0.6;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.3s ease;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .back-link:hover {
    color: var(--accent-color);
    opacity: 1;
  }

  .nav-arrows-top {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .nav-btn-top {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-color);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: background 0.3s ease, color 0.3s ease, transform 0.2s ease;
  }

  .nav-btn-top:hover {
    background: var(--accent-color);
    color: white;
    border-color: var(--accent-color);
    transform: translateY(-1px);
  }

  .nav-btn-icon {
    font-size: 1.2rem;
    line-height: 1;
  }

  .nav-btn-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* ==========================================================
     IMMAGINE DI COPERTINA - MANTIENE LE PROPORZIONI
     ========================================================== */
  .cover-image {
    margin-bottom: 2rem;
    border-radius: 12px;
    overflow: hidden;
    width: 100%;
    background: var(--secondary-color);
    position: relative;
  }

  .cover-image img {
    width: 100%;
    height: auto;
    max-height: 600px;
    object-fit: contain; /* ← Cambiato da cover a contain per mantenere le proporzioni */
    display: block;
    background: transparent;
  }

  /* ==========================================================
     INTESTAZIONE
     ========================================================== */
  .news-header {
    margin-bottom: 2rem;
  }

  .news-header h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--text-color);
    margin: 0 0 0.5rem 0;
    line-height: 1.2;
  }

  .news-date {
    font-size: 0.9rem;
    color: var(--text-color);
    opacity: 0.5;
    display: block;
    margin-bottom: 0.75rem;
  }

  .news-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(125, 10, 10, 0.06);
  }

  .meta-item {
    font-size: 0.9rem;
    color: var(--text-color);
    opacity: 0.7;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .meta-item a {
    color: var(--accent-color);
    text-decoration: none;
  }

  .meta-item a:hover {
    text-decoration: underline;
  }

  /* ==========================================================
     CONTENUTO MARKDOWN
     ========================================================== */
  .news-content {
    font-size: 1.05rem;
    line-height: 1.9;
    color: var(--text-color);
    max-width: 850px;
    margin: 0 auto;
  }

  .news-content h2 {
    font-size: 1.6rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .news-content h3 {
    font-size: 1.3rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }

  .news-content p {
    margin-bottom: 1.25rem;
  }

  .news-content a {
    color: var(--accent-color);
    text-decoration: none;
  }

  .news-content a:hover {
    text-decoration: underline;
  }

  .news-content ul,
  .news-content ol {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .news-content img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.5rem 0;
  }

  .news-content blockquote {
    border-left: 4px solid var(--accent-color);
    padding-left: 1.5rem;
    margin-left: 0;
    opacity: 0.8;
    font-style: italic;
  }

  /* ==========================================================
     GALLERIA
     ========================================================== */
  .news-gallery {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(125, 10, 10, 0.08);
    max-width: 850px;
    margin-left: auto;
    margin-right: auto;
  }

  .news-gallery h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 1rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }

  .gallery-item {
    overflow: hidden;
    border-radius: 6px;
    aspect-ratio: 1 / 1;
    background: var(--secondary-color);
    cursor: pointer;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .gallery-item img:hover {
    transform: scale(1.05);
  }

  /* ==========================================================
     NAVIGAZIONE INFERIORE - ORDINE CORRETTO
     ========================================================== */
  .news-nav-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(125, 10, 10, 0.06);
    gap: 1rem;
    max-width: 850px;
    margin-left: auto;
    margin-right: auto;
  }

  .nav-bottom-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-color);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    padding: 0.5rem 0;
    transition: color 0.3s ease, transform 0.2s ease;
    max-width: 40%;
    flex: 1;
  }

  .nav-bottom-link:hover {
    color: var(--accent-color);
  }

  .nav-bottom-link.prev {
    justify-content: flex-start;
  }

  .nav-bottom-link.next {
    justify-content: flex-end;
  }

  .nav-bottom-link.center {
    color: var(--text-color);
    opacity: 0.6; /* Aumentato da 0.4 a 0.6 per renderlo più visibile */
    font-size: 0.85rem;
    flex-shrink: 0;
    justify-content: center;
    flex: 0 0 auto;
    font-weight: 500;
  }

  .nav-bottom-link.center:hover {
    color: var(--accent-color);
    opacity: 1;
  }

  .nav-bottom-arrow {
    font-size: 1.2rem;
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .nav-bottom-link.prev:hover .nav-bottom-arrow {
    transform: translateX(-4px);
  }

  .nav-bottom-link.next:hover .nav-bottom-arrow {
    transform: translateX(4px);
  }

  .nav-bottom-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ==========================================================
     LIGHTBOX
     ========================================================== */
  .lightbox {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    justify-content: center;
    align-items: center;
    z-index: 9999;
    padding: 2rem;
    flex-direction: column;
  }

  .lightbox.active {
    display: flex;
  }

  .lightbox-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: none;
    border: none;
    color: white;
    font-size: 2rem;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.3s ease;
    z-index: 10;
  }

  .lightbox-close:hover {
    opacity: 1;
  }

  #lightboxImage {
    max-width: 90%;
    max-height: 75vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  .lightbox-controls {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .lightbox-btn {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    font-size: 1.8rem;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    cursor: pointer;
    transition: background 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-btn:hover {
    background: var(--accent-color);
    border-color: var(--accent-color);
  }

  .lightbox-counter {
    color: white;
    font-size: 0.9rem;
    opacity: 0.7;
    font-weight: 400;
    min-width: 60px;
    text-align: center;
  }

  /* ==========================================================
     MOBILE
     ========================================================== */
  @media (max-width: 768px) {
    .news-single {
      padding: 85px 0 3rem 0;
    }

    .news-nav-top {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
      margin-top: 2rem;
    }

    .nav-arrows-top {
      justify-content: space-between;
    }

    .nav-btn-top {
      flex: 1;
      justify-content: center;
      padding: 0.5rem 0.8rem;
    }

    .nav-btn-label {
      font-size: 0.75rem;
    }

    .cover-image {
      border-radius: 8px;
    }

    .cover-image img {
      max-height: 300px;
    }

    .news-header h1 {
      font-size: 1.6rem;
    }

    .news-meta {
      flex-direction: column;
      gap: 0.3rem;
    }

    .news-content {
      font-size: 0.95rem;
      line-height: 1.8;
    }

    .news-content h2 {
      font-size: 1.3rem;
    }

    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .news-nav-bottom {
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
      padding-top: 1.5rem;
    }

    .nav-bottom-link {
      max-width: 100%;
      justify-content: center !important;
      padding: 0.5rem 0;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.04);
      transition: background 0.3s ease;
    }

    .nav-bottom-link:hover {
      background: rgba(191, 49, 49, 0.06);
    }

    .nav-bottom-link.center {
      order: -1;
      background: transparent;
      font-size: 0.8rem;
      padding: 0.25rem 0;
      opacity: 0.7;
    }

    .nav-bottom-text {
      white-space: normal;
    }

    .lightbox {
      padding: 1rem;
    }

    #lightboxImage {
      max-width: 100%;
      max-height: 60vh;
    }

    .lightbox-controls {
      gap: 1rem;
    }

    .lightbox-btn {
      width: 40px;
      height: 40px;
      font-size: 1.4rem;
    }
  }

  @media (max-width: 480px) {
    .news-single {
      padding: 75px 0 2rem 0;
    }

    .cover-image img {
      max-height: 220px;
    }

    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.5rem;
    }

    .lightbox-close {
      top: 1rem;
      right: 1rem;
      font-size: 1.5rem;
    }

    .lightbox-btn {
      width: 36px;
      height: 36px;
      font-size: 1.2rem;
    }

    .lightbox-controls {
      gap: 0.75rem;
    }

    .nav-btn-top {
      font-size: 0.75rem;
    }

    .nav-btn-icon {
      font-size: 1rem;
    }
  }
</style>

<script>
    // @ts-nocheck

  (function() {
    var currentImages = [];
    var currentIndex = 0;
    var lightbox = null;
    var lightboxImage = null;
    var lightboxCounter = null;
    var lightboxControls = null;

    function setLightboxElements() {
      lightbox = document.getElementById('lightbox');
      lightboxImage = document.getElementById('lightboxImage');
      lightboxCounter = document.getElementById('lightboxCounter');
      lightboxControls = document.querySelector('.lightbox-controls');
    }

    function initGallery() {
      var galleryItems = document.querySelectorAll('.gallery-item img');
      currentImages = Array.from(galleryItems).map(function(img) {
        return img.src;
      });
    }

    function updateLightbox() {
      if (!lightboxImage || !lightboxCounter || currentImages.length === 0) {
        return;
      }

      lightboxImage.src = currentImages[currentIndex] || '';
      lightboxCounter.textContent = (currentIndex + 1) + ' / ' + currentImages.length;
    }

    window.openLightbox = function(imgElement) {
      if (!imgElement) {
        return;
      }

      setLightboxElements();
      initGallery();

      var galleryItem = imgElement.closest('.gallery-item');
      if (!galleryItem) {
        return;
      }

      var index = parseInt(galleryItem.getAttribute('data-index') || '0', 10);
      currentIndex = Number.isNaN(index) ? 0 : index;

      if (currentIndex < 0 || currentIndex >= currentImages.length) {
        currentIndex = 0;
      }

      updateLightbox();

      if (lightbox) {
        lightbox.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    };

    window.closeLightbox = function() {
      setLightboxElements();
      if (lightbox) {
        lightbox.classList.remove('active');
        document.body.style.overflow = '';
      }
    };

    window.changeImage = function(direction) {
      var newIndex = currentIndex + direction;
      if (newIndex >= 0 && newIndex < currentImages.length) {
        currentIndex = newIndex;
        updateLightbox();
      }
    };

    document.addEventListener('DOMContentLoaded', function() {
      setLightboxElements();
      initGallery();

      if (lightboxImage) {
        lightboxImage.addEventListener('click', function(e) {
          e.stopPropagation();
        });
      }

      if (lightboxControls) {
        lightboxControls.addEventListener('click', function(e) {
          e.stopPropagation();
        });
      }

      document.addEventListener('keydown', function(e) {
        if (!lightbox || !lightbox.classList.contains('active')) {
          return;
        }

        if (e.key === 'Escape') {
          window.closeLightbox();
        } else if (e.key === 'ArrowLeft') {
          window.changeImage(-1);
        } else if (e.key === 'ArrowRight') {
          window.changeImage(1);
        }
      });
    });
  })();
</script>