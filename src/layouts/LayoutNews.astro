---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import NavbarNews from '../components/NavbarNews.astro';

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<!-- IUBENDA - CONFIGURAZIONE COMPLETA -->
		<script type="text/javascript">
			var _iub = _iub || [];
			_iub.csConfiguration = {
			cookiePolicyId: 38896889,
			siteId: 4638979,
			lang: 'it',
			perPurposeConsent: true,
			enableLgpd: true,
			enableUspr: true,
			floatingPreferencesButtonDisplay: 'bottom-right',
			
			// === FORZA IL CONSENSO SU TUTTO IL SITO ===
			consentOnContinuedBrowsing: true,
			reloadOnConsent: false,
			askConsentAtCookiePolicyUpdate: true,

			// === STORAGE ===
			storage: {
				useSiteId: true
			},
			
			// === BANNER ===
			banner: {
				acceptButtonDisplay: true,
				closeButtonDisplay: false,
				customizeButtonDisplay: true,
				explicitWithdrawal: true,
				listPurposes: true,
				position: 'float-bottom-right',
				rejectButtonDisplay: true,
				showTitle: false,
				showTotalNumberOfProviders: true
			},
			// === FORZA IL DOMINIO (se necessario) ===
			cookieDomain: window.location.hostname,
			
			// === CALLBACK PER VERIFICARE IL CONSENSO ===
			callback: {
				onPreferenceExpressed: function(data) {
				console.log('Consenso espresso:', data);
				}
			}
			};
		</script>
		<script type="text/javascript" src="https://embeds.iubenda.com/widgets/eb6c1d61-4373-40db-ae76-629640268254.js"></script>

		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<!-- Font -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Mulish:wght@400;600;700;800&display=swap" rel="stylesheet" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"/>
		<title>{title}</title>
	</head>
	<body>
		<NavbarNews />
		<slot />

		<Footer />



		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	div {
		height: 100vh;
	}
</style>
